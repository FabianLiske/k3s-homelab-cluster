apiVersion: v1
kind: Secret
metadata:
  name: openclaw-secrets
  namespace: svc-openclaw
type: Opaque
stringData:
  OPENCLAW_GATEWAY_TOKEN: "generate-a-long-random-token"
  # Add at least one model provider key, then encrypt openclaw-secret.yaml with SOPS.
  # ANTHROPIC_API_KEY: "..."
  # OPENAI_API_KEY: "..."
  # GEMINI_API_KEY: "..."
  # OPENROUTER_API_KEY: "..."
