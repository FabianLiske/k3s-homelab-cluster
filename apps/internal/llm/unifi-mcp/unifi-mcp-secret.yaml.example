# Copy this file to unifi-mcp-secret.yaml and replace the placeholders.
#
# Required format:
#   UNIFI_API_KEY   UniFi Network API key (created in the Network UI under
#                   Integrations / API Keys). Use a dedicated view-only admin
#                   user, since UniFi API keys have no own scopes.
#   MCP_AUTH_TOKEN  Bearer token MCP clients (LiteLLM) must send on /mcp.
#                   Recommended: `openssl rand -hex 32`.
#
# SOPS encryption after inserting the values:
#   sops --encrypt --in-place apps/internal/llm/unifi-mcp/unifi-mcp-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: unifi-mcp-secret
  namespace: svc-llm
type: Opaque
stringData:
  UNIFI_API_KEY: REPLACE_WITH_UNIFI_API_KEY
  MCP_AUTH_TOKEN: REPLACE_WITH_MCP_AUTH_TOKEN
