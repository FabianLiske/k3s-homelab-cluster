# Copy this file to hermes-secret.yaml, replace the placeholder values, then
# encrypt it in place (the SOPS age key lives in the repo as age.cluster.key):
#
#   sops --encrypt --in-place apps/internal/hermes/hermes-secret.yaml
#
# Never commit the decrypted file, and never paste real values into this
# .example file.
#
# Value notes:
#
#   LITELLM_API_KEY
#       Master key of the LiteLLM router. Must be identical to
#       LITELLM_MASTER_KEY in the secret `litellm-secrets` in namespace
#       `svc-llm` (apps/internal/llm/litellm). Without it every model request
#       is rejected by the router.
#
#   API_SERVER_KEY
#       Bearer key for the Hermes OpenAI-compatible API server (port 8642).
#       Required for every request (including /health/detailed).
#       Generate: printf '%s\n' "$(openssl rand -hex 32)"
#
#   HERMES_DASHBOARD_BASIC_AUTH_USERNAME
#       Dashboard login name (activates the bundled basic-auth provider).
#
#   HERMES_DASHBOARD_BASIC_AUTH_PASSWORD
#       Dashboard login password (plaintext; Hermes stores it only in memory,
#       the session cookie is signed by ..._SECRET).
#
#   HERMES_DASHBOARD_BASIC_AUTH_SECRET
#       Token-signing key so dashboard sessions survive restarts.
#       Generate: openssl rand -base64 32
apiVersion: v1
kind: Secret
metadata:
  name: hermes-secret
  namespace: svc-hermes
type: Opaque
stringData:
  LITELLM_API_KEY: "REPLACE-WITH-LITELLM-MASTER-KEY"
  API_SERVER_KEY: "REPLACE-WITH-openssl-rand-hex-32"
  HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "REPLACE"
  HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: "REPLACE-WITH-a-strong-password"
  HERMES_DASHBOARD_BASIC_AUTH_SECRET: "REPLACE-WITH-openssl-rand-base64-32"
